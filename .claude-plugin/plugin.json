{
  "name": "perfect-hub",
  "version": "4.0.0",
  "description": "Perfect Hub: an office of specialist agents. /absolute convenes a council of product, architecture, frontend, backend, UX, visual, security, QA, devops and domain experts who propose, critique each other hard, credit what is strong and reach a written decision, then build behind TDD and review gates. /absolute-goal takes an idea to release; /antislop removes AI template traces. Components: selling, ads, office, business, brand, social, marketing, research, translate.",
  "author": {
    "name": "ValentinHol0",
    "url": "https://github.com/ValentinHol0"
  },
  "homepage": "https://github.com/ValentinHol0/perfect-hub",
  "repository": "https://github.com/ValentinHol0/perfect-hub",
  "keywords": [
    "perfect-hub",
    "absolute",
    "council",
    "multi-agent",
    "debate",
    "goal",
    "tdd",
    "design",
    "anti-slop",
    "selling",
    "ads",
    "marketing",
    "office",
    "brand",
    "social",
    "research",
    "translate",
    "business"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/restore-state.js\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/pre-compact.js\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/goal-guard.js\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/lint-on-edit.js\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "icon": "assets/icon.png"
}
